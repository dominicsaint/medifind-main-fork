        <mxCell id="api_auth" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=8;shadow=1;" value="&lt;b style=&quot;font-size:12px;color:#1e3a8a;&quot;&gt;Auth &amp; Identity API (/api/v1/auth)&lt;/b&gt;&lt;hr style=&quot;border-color:#cbd5e1;&quot;&gt;&lt;b&gt;POST /register&lt;/b&gt; [Public] Register customer/rider&lt;br&gt;&lt;b&gt;POST /login&lt;/b&gt; [Public] Credentials -&gt; JWT Tokens&lt;br&gt;&lt;b&gt;POST /refresh&lt;/b&gt; [Public] Rotate refresh token&lt;br&gt;&lt;b&gt;POST /verify-phone&lt;/b&gt; [User] Validate SMS OTP&lt;br&gt;&lt;b&gt;POST /mfa/validate&lt;/b&gt; [Pharm/Admin] MFA token check&lt;br&gt;&lt;b&gt;GET /me&lt;/b&gt; [Authenticated] User profile &amp; roles" vertex="1">
          <mxGeometry height="220" width="360" x="40" y="95" as="geometry" />
        </mxCell>
        <mxCell id="api_cust" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=8;shadow=1;" value="&lt;b style=&quot;font-size:12px;color:#2563eb;&quot;&gt;Customer &amp; Discovery API (/api/v1/customer)&lt;/b&gt;&lt;hr style=&quot;border-color:#cbd5e1;&quot;&gt;&lt;b&gt;GET /medicines/search&lt;/b&gt; [Customer] Fuzzy search catalog&lt;br&gt;&lt;b&gt;GET /pharmacies/nearby&lt;/b&gt; [Customer] coordinate-based location search&lt;br&gt;&lt;b&gt;GET /cart&lt;/b&gt; [Customer] Retrieve session cart&lt;br&gt;&lt;b&gt;POST /cart/items&lt;/b&gt; [Customer] Add item with quantity&lt;br&gt;&lt;b&gt;POST /prescriptions/upload&lt;/b&gt; [Customer] private file upload&lt;br&gt;&lt;b&gt;POST /orders/checkout&lt;/b&gt; [Customer] Submit order" vertex="1">
          <mxGeometry height="220" width="370" x="440" y="95" as="geometry" />
        </mxCell>
        <mxCell id="api_pharm" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=8;shadow=1;" value="&lt;b style=&quot;font-size:12px;color:#059669;&quot;&gt;Pharmacist Workstation API (/api/v1/pharmacy)&lt;/b&gt;&lt;hr style=&quot;border-color:#cbd5e1;&quot;&gt;&lt;b&gt;GET /inventory&lt;/b&gt; [Pharm] Stock levels &amp; batches&lt;br&gt;&lt;b&gt;POST /inventory/batches&lt;/b&gt; [Pharm] Add stock batch lot&lt;br&gt;&lt;b&gt;GET /prescriptions/pending&lt;/b&gt; [Pharm] Review queue&lt;br&gt;&lt;b&gt;POST /prescriptions/{id}/review&lt;/b&gt; [Pharm] Approve/Reject&lt;br&gt;&lt;b&gt;POST /orders/{id}/ready&lt;/b&gt; [Pharm] Tamper seal registered&lt;br&gt;&lt;b&gt;POST /orders/{id}/handover&lt;/b&gt; [Pharm] Scan rider badge" vertex="1">
          <mxGeometry height="220" width="380" x="850" y="95" as="geometry" />
        </mxCell>
        <mxCell id="api_rider" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=8;shadow=1;" value="&lt;b style=&quot;font-size:12px;color:#d97706;&quot;&gt;Rider &amp; Dispatch API (/api/v1/rider)&lt;/b&gt;&lt;hr style=&quot;border-color:#cbd5e1;&quot;&gt;&lt;b&gt;POST /availability/toggle&lt;/b&gt; [Rider] Online / Offline&lt;br&gt;&lt;b&gt;POST /assignments/{id}/accept&lt;/b&gt; [Rider] Accept 45s offer&lt;br&gt;&lt;b&gt;POST /deliveries/{id}/pickup&lt;/b&gt; [Rider] Confirm pharmacy pickup&lt;br&gt;&lt;b&gt;POST /deliveries/{id}/verify-otp&lt;/b&gt; [Rider] Validate customer OTP&lt;br&gt;&lt;b&gt;POST /deliveries/{id}/return&lt;/b&gt; [Rider] Report unreachable&lt;br&gt;&lt;b&gt;GET /earnings&lt;/b&gt; [Rider] Balance &amp; payout history" vertex="1">
          <mxGeometry height="220" width="380" x="1270" y="95" as="geometry" />
        </mxCell>
        <mxCell id="api_pay" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=8;shadow=1;" value="&lt;b style=&quot;font-size:12px;color:#0f766e;&quot;&gt;Payments &amp; Ledger API (/api/v1/payments)&lt;/b&gt;&lt;hr style=&quot;border-color:#cbd5e1;&quot;&gt;&lt;b&gt;POST /initiate&lt;/b&gt; [Customer] MoMo / Card checkout session&lt;br&gt;&lt;b&gt;POST /webhook&lt;/b&gt; [Gateway] HMAC-SHA256 verified callback&lt;br&gt;&lt;b&gt;POST /escrow/release&lt;/b&gt; [Internal] Credit ledger on OTP&lt;br&gt;&lt;b&gt;POST /refund&lt;/b&gt; [Admin] Cancelled order reimbursement&lt;br&gt;&lt;b&gt;GET /ledger/statement&lt;/b&gt; [Pharm/Admin] Reconciliation" vertex="1">
          <mxGeometry height="220" width="360" x="40" y="345" as="geometry" />
        </mxCell>
        <mxCell id="api_admin" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=8;shadow=1;" value="&lt;b style=&quot;font-size:12px;color:#5b21b6;&quot;&gt;Admin Operations API (/api/v1/admin)&lt;/b&gt;&lt;hr style=&quot;border-color:#cbd5e1;&quot;&gt;&lt;b&gt;GET /verifications/pending&lt;/b&gt; [Admin] KYC Review queue&lt;br&gt;&lt;b&gt;POST /verifications/{id}/decision&lt;/b&gt; [Admin] Approve/Reject&lt;br&gt;&lt;b&gt;GET /operations/live-map&lt;/b&gt; [Admin] Active dispatch tracking&lt;br&gt;&lt;b&gt;POST /dispatch/reassign&lt;/b&gt; [Admin] Manual rider override&lt;br&gt;&lt;b&gt;POST /settlements/execute&lt;/b&gt; [Admin] Batch Mobile Money run&lt;br&gt;&lt;b&gt;GET /audit/logs&lt;/b&gt; [SuperAdmin] Immutable access trail" vertex="1">
          <mxGeometry height="220" width="370" x="440" y="345" as="geometry" />
        </mxCell>
        <mxCell id="api_wss" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=8;shadow=1;" value="&lt;b&gt;Live delivery updates&lt;/b&gt;&lt;br&gt;Spring Boot WebSocket endpoint can send rider location and order status updates.&lt;br&gt;&lt;br&gt;&lt;b&gt;Internal backend events&lt;/b&gt;&lt;br&gt;Spring Application Events can notify modules when an order is placed, approved, ready, or delivered. No separate queue service is needed for the initial version." vertex="1">
          <mxGeometry height="220" width="800" x="850" y="345" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p13-security" name="PAGE 13 — Security Architecture">
    <mxGraphModel dx="1679" dy="1755" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_2" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#0f172a;strokeColor=#1e293b;fontColor=#ffffff;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6;shadow=1;" value="&lt;b&gt;MEDIFIND | APPLICATION SECURITY &amp;amp; ACCESS CONTROL&lt;/b&gt;&lt;br&gt;Protect accounts, health information, payments and delivery workflows" vertex="1">
          <mxGeometry height="54" width="1620" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="sec_l1" parent="1" style="swimlane;html=1;rounded=1;startSize=26;horizontal=1;fillColor=#f8fafc;swimlaneFillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#334155;fontStyle=1;fontSize=12;strokeWidth=1.4;shadow=1;" value="&lt;b&gt;1. Secure Connections&lt;/b&gt;" vertex="1">
          <mxGeometry height="130" width="1580" x="40" y="95" as="geometry" />
        </mxCell>
        <mxCell id="sb_1" parent="sec_l1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b&gt;HTTPS&lt;/b&gt;&lt;br&gt;Serve the PWA and API over encrypted connections." vertex="1">
          <mxGeometry height="75" width="460" x="30" y="36" as="geometry" />
        </mxCell>
        <mxCell id="sb_2" parent="sec_l1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b&gt;Validate requests&lt;/b&gt;&lt;br&gt;Check user input and limit repeated login or OTP attempts in Spring Boot." vertex="1">
          <mxGeometry height="75" width="480" x="530" y="36" as="geometry" />
        </mxCell>
        <mxCell id="sb_3" parent="sec_l1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b&gt;Keep credentials private&lt;/b&gt;&lt;br&gt;Store database credentials on the backend, never in the React PWA." vertex="1">
          <mxGeometry height="75" width="490" x="1050" y="36" as="geometry" />
        </mxCell>
        <mxCell id="sec_l2" parent="1" style="swimlane;html=1;rounded=1;startSize=26;horizontal=1;fillColor=#eff6ff;swimlaneFillColor=#ffffff;strokeColor=#93c5fd;fontColor=#1e3a8a;fontStyle=1;fontSize=12;strokeWidth=1.4;shadow=1;" value="&lt;b&gt;2. Sign-in&lt;/b&gt;" vertex="1">
          <mxGeometry height="140" width="1580" x="40" y="245" as="geometry" />
        </mxCell>
        <mxCell id="sb_4" parent="sec_l2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b&gt;Password handling&lt;/b&gt;&lt;br&gt;Store password hashes, never plain text passwords." vertex="1">
          <mxGeometry height="85" width="460" x="30" y="36" as="geometry" />
        </mxCell>
        <mxCell id="sb_5" parent="sec_l2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b&gt;Spring Security&lt;/b&gt;&lt;br&gt;Use the backend to authenticate users and protect API requests." vertex="1">
          <mxGeometry height="85" width="480" x="530" y="36" as="geometry" />
        </mxCell>
        <mxCell id="sb_6" parent="sec_l2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b&gt;Admin access&lt;/b&gt;&lt;br&gt;Require stronger sign-in protections for administrator accounts before launch." vertex="1">
          <mxGeometry height="85" width="490" x="1050" y="36" as="geometry" />
        </mxCell>
        <mxCell id="sec_l3" parent="1" style="swimlane;html=1;rounded=1;startSize=26;horizontal=1;fillColor=#f5f3ff;swimlaneFillColor=#ffffff;strokeColor=#c4b5fd;fontColor=#5b21b6;fontStyle=1;fontSize=12;strokeWidth=1.4;shadow=1;" value="&lt;b&gt;3. User Permissions&lt;/b&gt;" vertex="1">
          <mxGeometry height="160" width="1580" x="40" y="405" as="geometry" />
        </mxCell>
        <mxCell id="sb_7" parent="sec_l3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b&gt;Customer&lt;/b&gt;&lt;br&gt;Can access their own profile, prescriptions and orders." vertex="1">
          <mxGeometry height="105" width="350" x="30" y="36" as="geometry" />
        </mxCell>
        <mxCell id="sb_8" parent="sec_l3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b&gt;Pharmacy staff&lt;/b&gt;&lt;br&gt;Can manage their pharmacy and review assigned prescriptions." vertex="1">
          <mxGeometry height="105" width="360" x="410" y="36" as="geometry" />
        </mxCell>
        <mxCell id="sb_9" parent="sec_l3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b&gt;Rider&lt;/b&gt;&lt;br&gt;Can view assigned deliveries and submit delivery proof." vertex="1">
          <mxGeometry height="105" width="360" x="800" y="36" as="geometry" />
        </mxCell>
        <mxCell id="sb_10" parent="sec_l3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b&gt;Administrator&lt;/b&gt;&lt;br&gt;Can review accounts and help resolve order issues." vertex="1">
          <mxGeometry height="105" width="350" x="1190" y="36" as="geometry" />
        </mxCell>
        <mxCell id="sec_l4" parent="1" style="swimlane;html=1;rounded=1;startSize=26;horizontal=1;fillColor=#ecfdf5;swimlaneFillColor=#ffffff;strokeColor=#86efac;fontColor=#065f46;fontStyle=1;fontSize=12;strokeWidth=1.4;shadow=1;" value="&lt;b&gt;4. Protect Private Information&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="1580" x="40" y="585" as="geometry" />
        </mxCell>
        <mxCell id="sb_11" parent="sec_l4" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b&gt;Private documents&lt;/b&gt;&lt;br&gt;Keep prescriptions and identity files in a private Supabase Storage bucket. Backend checks access before sharing a file." vertex="1">
          <mxGeometry height="95" width="460" x="30" y="36" as="geometry" />
        </mxCell>
        <mxCell id="sb_12" parent="sec_l4" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b&gt;Prescription handling&lt;/b&gt;&lt;br&gt;Only authorized pharmacy staff should review prescriptions." vertex="1">
          <mxGeometry height="95" width="480" x="530" y="36" as="geometry" />
        </mxCell>
        <mxCell id="sb_13" parent="sec_l4" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b&gt;Collect only needed data&lt;/b&gt;&lt;br&gt;Limit who can see customer health, identity and location details. Confirm applicable requirements with the team." vertex="1">
          <mxGeometry height="95" width="490" x="1050" y="36" as="geometry" />
        </mxCell>
        <mxCell id="sec_l5" parent="1" style="swimlane;html=1;rounded=1;startSize=26;horizontal=1;fillColor=#fff7ed;swimlaneFillColor=#ffffff;strokeColor=#fed7aa;fontColor=#9a3412;fontStyle=1;fontSize=12;strokeWidth=1.4;shadow=1;" value="&lt;b&gt;5. Payments and Audit History&lt;/b&gt;" vertex="1">
          <mxGeometry height="140" width="1580" x="40" y="755" as="geometry" />
        </mxCell>
        <mxCell id="sb_14" parent="sec_l5" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b&gt;Delivery code&lt;/b&gt;&lt;br&gt;Store a protected version of the one-time code and limit incorrect attempts." vertex="1">
          <mxGeometry height="85" width="460" x="30" y="36" as="geometry" />
        </mxCell>
        <mxCell id="sb_15" parent="sec_l5" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b&gt;Payment callbacks&lt;/b&gt;&lt;br&gt;Verify payment provider messages on the Java backend before changing an order payment status." vertex="1">
          <mxGeometry height="85" width="480" x="530" y="36" as="geometry" />
        </mxCell>
        <mxCell id="sb_16" parent="sec_l5" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b&gt;Audit history&lt;/b&gt;&lt;br&gt;Record important account, order and approval actions in system_audit_logs." vertex="1">
          <mxGeometry height="85" width="490" x="1050" y="36" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
