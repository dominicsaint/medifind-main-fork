        <mxCell id="d_pg" parent="t5_data" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=11;align=center;verticalAlign=middle;strokeWidth=1.4;" value="&lt;b&gt;Supabase PostgreSQL&lt;/b&gt;&lt;br&gt;MediFind tables from database/schema.sql" vertex="1">
          <mxGeometry height="75" width="330" x="40" y="36" as="geometry" />
        </mxCell>
        <mxCell id="d_s3" parent="t5_data" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=11;align=center;verticalAlign=middle;strokeWidth=1.4;" value="&lt;b&gt;Supabase Storage&lt;/b&gt;&lt;br&gt;Private files for prescriptions and delivery proof" vertex="1">
          <mxGeometry height="75" width="340" x="800" y="36" as="geometry" />
        </mxCell>
        <mxCell id="arch_note" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;fontSize=11;align=left;verticalAlign=middle;strokeWidth=1.2;spacing=10;" value="&lt;b&gt;BEGINNER-FRIENDLY STARTING POINT:&lt;/b&gt; Keep the backend as one Java / Spring Boot application with clearly named modules. Use Supabase for PostgreSQL and private file storage. Add separate services or infrastructure only when a real feature requires them." vertex="1">
          <mxGeometry height="55" width="1574" x="40" y="910" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p03-customer" name="PAGE 3 — Customer Module Architecture">
    <mxGraphModel dx="1640" dy="1714" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_2" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#0f172a;strokeColor=#1e293b;fontColor=#ffffff;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:18px;&quot;&gt;MEDIFIND | CUSTOMER MODULE — FUNCTIONAL ARCHITECTURE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#94a3b8;&quot;&gt;Preserving &amp;amp; Expanding Customer Workflow: Discovery, Multi-Item Cart, Prescription Upload, Checkout, Live Tracking &amp;amp; Reminders&lt;/span&gt;" vertex="1">
          <mxGeometry height="54" width="1574" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="wf_banner" parent="1" style="rounded=1;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=1.5;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;fontColor=#1E3A8A;" value="CUSTOMER JOURNEY &amp; MODULE BOUNDARIES (ALIGNED WITH PROJECT FLOWCHART V2)" vertex="1">
          <mxGeometry height="40" width="1574" x="40" y="90" as="geometry" />
        </mxCell>
        <mxCell id="c_sec1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e3a8a;fontSize=11;align=center;verticalAlign=top;strokeWidth=1.4;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;1. Onboarding &amp;amp; Profile&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;• Open MediFind App / Web&lt;br&gt;• Check existing customer account&lt;br&gt;• Sign up: Name, Email, Phone, Pass&lt;br&gt;• Phone OTP Verification (SMS)&lt;br&gt;• Sign in &amp;amp; JWT session issue&lt;br&gt;• Address Book (GPS &amp;amp; Digital Address)&lt;br&gt;• Notification preferences&lt;br&gt;• Customer Dashboard Entry&lt;/div&gt;" vertex="1">
          <mxGeometry height="340" width="290" x="40" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c_sec2" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e3a8a;fontSize=11;align=center;verticalAlign=top;strokeWidth=1.4;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;2. Discovery &amp;amp; Search&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;• Search by medicine generic/brand name&lt;br&gt;• Filter by dosage, form, price, distance&lt;br&gt;• View pharmacies with verified stock&lt;br&gt;• Review pharmacy distance &amp;amp; ratings&lt;br&gt;• Review drug details &amp;amp; active ingredients&lt;br&gt;• Direct Pharmacy Discovery mode&lt;br&gt;• Search pharmacies &amp;amp; view map pins&lt;br&gt;• Check pharmacy hours &amp;amp; licenses&lt;/div&gt;" vertex="1">
          <mxGeometry height="340" width="290" x="360" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c_sec3" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e3a8a;fontSize=11;align=center;verticalAlign=top;strokeWidth=1.4;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;3. Cart &amp;amp; Prescriptions&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;• Add medicine to cart with quantity&lt;br&gt;• Pharmacy grouping validation&lt;br&gt;• Decision: Add more items? (Loop)&lt;br&gt;• Manage cart: Adjust qty, remove items&lt;br&gt;• Detect Rx-required medicines in cart&lt;br&gt;• Secure prescription upload (Camera/File)&lt;br&gt;• View prescriptions linked to purchases&lt;br&gt;• Review prescription approval status&lt;/div&gt;" vertex="1">
          <mxGeometry height="340" width="290" x="680" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c_sec4" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e3a8a;fontSize=11;align=center;verticalAlign=top;strokeWidth=1.4;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;4. Checkout &amp;amp; Payments&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;• Ready to order transition&lt;br&gt;• Select delivery address / geocode pin&lt;br&gt;• Review item subtotal, delivery fee &amp;amp; tax&lt;br&gt;• Place medicine order&lt;br&gt;• Select Payment Method:&lt;br&gt;&amp;nbsp;&amp;nbsp;- MTN Mobile Money&lt;br&gt;&amp;nbsp;&amp;nbsp;- Telecel Cash&lt;br&gt;&amp;nbsp;&amp;nbsp;- Visa / Mastercard Card&lt;br&gt;• Complete payment &amp;amp; escrow lock&lt;/div&gt;" vertex="1">
          <mxGeometry height="340" width="290" x="1000" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c_sec5" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e3a8a;fontSize=11;align=center;verticalAlign=top;strokeWidth=1.4;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;5. Tracking &amp;amp; Reminders&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;• View order &amp;amp; preparation status&lt;br&gt;• Live rider dispatch &amp;amp; GPS map tracking&lt;br&gt;• Receive Rider arrival notification&lt;br&gt;• Secure delivery OTP presentation&lt;br&gt;• Confirm receipt of sealed package&lt;br&gt;• Rate pharmacy &amp;amp; rider delivery&lt;br&gt;• Configure medication pill reminders&lt;br&gt;• Daily dosage push &amp;amp; SMS alarms&lt;/div&gt;" vertex="1">
          <mxGeometry height="340" width="290" x="1320" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c_backend_box" parent="1" style="swimlane;html=1;rounded=1;startSize=28;horizontal=1;fillColor=#eff6ff;swimlaneFillColor=#ffffff;strokeColor=#3b82f6;fontColor=#1e3a8a;fontStyle=1;strokeWidth=1.5;" value="&lt;b style=&quot;font-size:14px;color:#1e3a8a;&quot;&gt;CUSTOMER MODULE BACKEND ARCHITECTURE &amp;amp; SERVICES&lt;/b&gt;" vertex="1">
          <mxGeometry height="240" width="1574" x="40" y="520" as="geometry" />
        </mxCell>
        <mxCell id="cs_1" parent="c_backend_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;strokeWidth=1.2;spacing=8;" value="&lt;b style=&quot;color:#1e3a8a;&quot;&gt;Customer Identity &amp;amp; Profile Service&lt;/b&gt;&lt;hr&gt;• User Registration &amp;amp; Authentication&lt;br&gt;• Argon2id Password Hashing&lt;br&gt;• SMS OTP Phone Number Verification&lt;br&gt;• Multi-Address Book (latitude and longitude)&lt;br&gt;• Customer Notification Preference Engine" vertex="1">
          <mxGeometry height="175" width="350" x="30" y="42" as="geometry" />
        </mxCell>
        <mxCell id="cs_2" parent="c_backend_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;strokeWidth=1.2;spacing=8;" value="&lt;b style=&quot;color:#1e3a8a;&quot;&gt;Catalog Search &amp;amp; Geolocation Engine&lt;/b&gt;&lt;hr&gt;• Full-text fuzzy search on medicine names&lt;br&gt;• location search using saved coordinates: pharmacies within X km&lt;br&gt;• Real-time stock availability filter&lt;br&gt;• Price &amp;amp; Distance ranking algorithms&lt;br&gt;• Pharmacy details &amp;amp; license verification badge" vertex="1">
          <mxGeometry height="175" width="360" x="410" y="42" as="geometry" />
        </mxCell>
        <mxCell id="cs_3" parent="c_backend_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;strokeWidth=1.2;spacing=8;" value="&lt;b style=&quot;color:#1e3a8a;&quot;&gt;Cart, Rx &amp;amp; Checkout Orchestrator&lt;/b&gt;&lt;hr&gt;• Cart saved in PostgreSQL&lt;br&gt;• Prescription requirement enforcement&lt;br&gt;• Encrypted Rx attachment to pending order&lt;br&gt;• Payment Gateway integration (MoMo/Card)&lt;br&gt;• Escrow order hold state management" vertex="1">
          <mxGeometry height="175" width="360" x="800" y="42" as="geometry" />
        </mxCell>
        <mxCell id="cs_4" parent="c_backend_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;strokeWidth=1.2;spacing=8;" value="&lt;b style=&quot;color:#1e3a8a;&quot;&gt;Delivery Tracker &amp;amp; Reminder Scheduler&lt;/b&gt;&lt;hr&gt;• Live rider location updates through the Spring Boot API&lt;br&gt;• Customer 6-digit delivery OTP generation&lt;br&gt;• Medication Reminder Scheduler (Spring scheduled tasks)&lt;br&gt;• Push &amp;amp; SMS pill reminder alerts&lt;br&gt;• Order history &amp;amp; 1-click reorder mechanism" vertex="1">
          <mxGeometry height="175" width="350" x="1190" y="42" as="geometry" />
        </mxCell>
        <mxCell id="c_data_note" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;fontSize=11;align=left;verticalAlign=middle;strokeWidth=1.2;spacing=10;" value="&lt;b&gt;CUSTOMER MODULE DATA OWNERSHIP:&lt;/b&gt; Owns &lt;i&gt;CUSTOMERS&lt;/i&gt;, &lt;i&gt;CUSTOMER_ADDRESSES&lt;/i&gt;, &lt;i&gt;CARTS&lt;/i&gt;, &lt;i&gt;CART_ITEMS&lt;/i&gt;, and &lt;i&gt;MEDICATION_REMINDERS&lt;/i&gt;. Maintains read-access to approved medicine catalogs and pharmacy directories. Communicates with Order and Delivery modules via authenticated domain events." vertex="1">
          <mxGeometry height="55" width="1574" x="40" y="780" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p04-pharmacist" name="PAGE 4 — Pharmacist Module Architecture">
    <mxGraphModel dx="1640" dy="1714" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_2" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#0f172a;strokeColor=#1e293b;fontColor=#ffffff;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:18px;&quot;&gt;MEDIFIND | PHARMACIST MODULE — COMPREHENSIVE ARCHITECTURE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#94a3b8;&quot;&gt;End-to-End Pharmacy Operations: Regulatory Onboarding, Catalog, Batch Inventory, Prescription Review, Dispensing, Handover &amp;amp; Financials&lt;/span&gt;" vertex="1">
          <mxGeometry height="54" width="1574" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="ph_1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontColor=#065f46;fontSize=11;align=center;verticalAlign=top;strokeWidth=1.4;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;A. Registration &amp;amp; Governance&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;text-align:left;&quot;&gt;• Pharmacy business profile &amp;amp; facility license&lt;br&gt;• Pharmacy Council of Ghana verification&lt;br&gt;• Physical geocoded premises location&lt;br&gt;• Weekly operating &amp;amp; emergency hours&lt;br&gt;• Pharmacist &amp;amp; Dispensing Technician accounts&lt;br&gt;• Granular staff roles &amp;amp; permissions&lt;br&gt;• Admin review, approval, or suspension status&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="360" x="40" y="95" as="geometry" />
        </mxCell>
        <mxCell id="ph_2" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontColor=#065f46;fontSize=11;align=center;verticalAlign=top;strokeWidth=1.4;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;B. Medicine Catalogue Master&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;text-align:left;&quot;&gt;• Add &amp;amp; maintain medicine listings&lt;br&gt;• Generic formulation vs Brand trade names&lt;br&gt;• Therapeutic category classification&lt;br&gt;• Dosage, strength, route &amp;amp; unit packaging&lt;br&gt;• Prescription-required (Rx vs OTC) flag&lt;br&gt;• Storage requirements (Cold-chain flag)&lt;br&gt;• Packaging imagery &amp;amp; patient leaflet PDFs&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="360" x="440" y="95" as="geometry" />
        </mxCell>
        <mxCell id="ph_3" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontColor=#065f46;fontSize=11;align=center;verticalAlign=top;strokeWidth=1.4;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;C. Inventory &amp;amp; Batch Tracking&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;text-align:left;&quot;&gt;• Real-time stock levels per pharmacy branch&lt;br&gt;• Batch &amp;amp; Lot number tracking for traceability&lt;br&gt;• Expiry date monitoring &amp;amp; early warnings (90/60/30)&lt;br&gt;• Automatic stock reservations on pending orders&lt;br&gt;• Manual adjustment audit with reason codes&lt;br&gt;• Automated low-stock replenishment alerts&lt;br&gt;• Discard / Quarantine expired batch logs&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="360" x="840" y="95" as="geometry" />
        </mxCell>
        <mxCell id="ph_4" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontColor=#065f46;fontSize=11;align=center;verticalAlign=top;strokeWidth=1.4;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;D. Prescription Review Workstation&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;text-align:left;&quot;&gt;• Secure queue of customer-submitted prescriptions&lt;br&gt;• High-resolution viewer with zoom &amp;amp; contrast&lt;br&gt;• Verification of prescriber PIN, date &amp;amp; dosage&lt;br&gt;• Clinical decisions: Approve, Reject, or Clarify&lt;br&gt;• Record reviewing pharmacist identity &amp;amp; license PIN&lt;br&gt;• Customer messaging for clinical clarification&lt;br&gt;• Strict Ghana Act 857 / Act 843 compliance&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="370" x="1240" y="95" as="geometry" />
        </mxCell>
        <mxCell id="ph_5" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontColor=#065f46;fontSize=11;align=center;verticalAlign=top;strokeWidth=1.4;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;E. Order Fulfillment &amp;amp; Dispensing&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;text-align:left;&quot;&gt;• Real-time audio/visual alert for new orders&lt;br&gt;• Full order items &amp;amp; dosage inspection&lt;br&gt;• Confirm physical item availability&lt;br&gt;• Accept order or reject with clinical reason&lt;br&gt;• Propose generic/brand substitution workflow&lt;br&gt;• Patient approval required for price/drug change&lt;br&gt;• Order preparation state progression tracking&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="360" x="40" y="320" as="geometry" />
        </mxCell>
        <mxCell id="ph_6" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontColor=#065f46;fontSize=11;align=center;verticalAlign=top;strokeWidth=1.4;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;F. Packaging &amp;amp; Rider Handover&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;text-align:left;&quot;&gt;• Professional medication dispensing &amp;amp; labeling&lt;br&gt;• Packaging into tamper-evident opaque bags&lt;br&gt;• Apply tamper seal barcode / serial number&lt;br&gt;• Mark order &quot;Ready for Rider Collection&quot;&lt;br&gt;• View assigned rider photo, name &amp;amp; vehicle&lt;br&gt;• Rider pickup verification (Scan QR / Code)&lt;br&gt;• Timestamped pickup evidence recorded&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="360" x="440" y="320" as="geometry" />
        </mxCell>
        <mxCell id="ph_7" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontColor=#065f46;fontSize=11;align=center;verticalAlign=top;strokeWidth=1.4;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;G. Pharmacy Financial Ledger&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;text-align:left;&quot;&gt;• Real-time sales revenue &amp;amp; completed orders&lt;br&gt;• MediFind platform commission deductions&lt;br&gt;• Escrow clearing upon delivery confirmation&lt;br&gt;• Bank / Mobile Money automated weekly settlements&lt;br&gt;• Refund deductions &amp;amp; dispute adjustments&lt;br&gt;• Exportable tax &amp;amp; financial audit statements&lt;br&gt;• Transaction-level reconciliation reports&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="360" x="840" y="320" as="geometry" />
        </mxCell>
        <mxCell id="ph_8" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontColor=#065f46;fontSize=11;align=center;verticalAlign=top;strokeWidth=1.4;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;H. Operational Dashboard &amp;amp; Alerts&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;text-align:left;&quot;&gt;• Immediate push alerts for urgent orders&lt;br&gt;• Pending prescription verification counter&lt;br&gt;• Approaching batch expiry warning table&lt;br&gt;• Stockout &amp;amp; low-inventory notifications&lt;br&gt;• Rider arrival notification (within 200m)&lt;br&gt;• Turnaround time &amp;amp; fulfillment SLA metrics&lt;br&gt;• Dispensing pharmacist activity audit logs&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="370" x="1240" y="320" as="geometry" />
        </mxCell>
        <mxCell id="ph_data_box" parent="1" style="swimlane;html=1;rounded=1;startSize=28;horizontal=1;fillColor=#ecfdf5;swimlaneFillColor=#ffffff;strokeColor=#10b981;fontColor=#065f46;fontStyle=1;strokeWidth=1.5;" value="&lt;b style=&quot;font-size:13px;color:#065f46;&quot;&gt;PHARMACY SUB-SYSTEM DOMAIN SERVICES &amp;amp; DATABASE ENTITIES&lt;/b&gt;" vertex="1">
          <mxGeometry height="215" width="1574" x="40" y="545" as="geometry" />
        </mxCell>
        <mxCell id="pe_1" parent="ph_data_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;strokeWidth=1.2;spacing=8;" value="&lt;b&gt;Pharmacy and Staff&lt;/b&gt;&lt;br&gt;PHARMACIES • PHARMACY_STAFF • PHARMACY_HOURS" vertex="1">
          <mxGeometry height="155" width="350" x="30" y="38" as="geometry" />
        </mxCell>
        <mxCell id="pe_2" parent="ph_data_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;strokeWidth=1.2;spacing=8;" value="&lt;b&gt;Medicine and Stock&lt;/b&gt;&lt;br&gt;MEDICINE_CATEGORIES • MEDICINES • PHARMACY_INVENTORY • INVENTORY_BATCHES • STOCK_MOVEMENTS" vertex="1">
          <mxGeometry height="155" width="360" x="410" y="38" as="geometry" />
        </mxCell>
        <mxCell id="pe_3" parent="ph_data_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;strokeWidth=1.2;spacing=8;" value="&lt;b&gt;Prescription Review&lt;/b&gt;&lt;br&gt;PRESCRIPTIONS • PRESCRIPTION_REVIEWS" vertex="1">
          <mxGeometry height="155" width="360" x="800" y="38" as="geometry" />
        </mxCell>
        <mxCell id="pe_4" parent="ph_data_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;fontColor=#0f172a;fontSize=11;align=left;verticalAlign=top;strokeWidth=1.2;spacing=8;" value="&lt;b&gt;Orders and Delivery&lt;/b&gt;&lt;br&gt;ORDERS • ORDER_ITEMS • DELIVERIES • DELIVERY_ASSIGNMENTS • DELIVERY_PROOFS" vertex="1">
          <mxGeometry height="155" width="350" x="1190" y="38" as="geometry" />
        </mxCell>
        <mxCell id="ph_note" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;fontSize=11;align=left;verticalAlign=middle;strokeWidth=1.2;spacing=10;" value="&lt;b&gt;PHARMACY INTEGRATION MANDATE:&lt;/b&gt; The Pharmacist Module strictly enforces professional verification before dispensing. Prescription validation cannot be bypassed. Controlled medications require dual-verification. Order packaging must be sealed before rider handover, establishing a legally compliant pharmaceutical distribution model." vertex="1">
          <mxGeometry height="55" width="1574" x="40" y="780" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p05-rider" name="PAGE 5 — Rider Module Architecture">
    <mxGraphModel dx="1640" dy="1714" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_2" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#0f172a;strokeColor=#1e293b;fontColor=#ffffff;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:18px;&quot;&gt;MEDIFIND | RIDER MODULE — DETAILED SYSTEM ARCHITECTURE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#94a3b8;&quot;&gt;Preserving &amp;amp; Advancing Established Rider Architecture: Dual Employment Modes, Dispatch Engine, Navigation, OTP &amp;amp; Returns&lt;/span&gt;" vertex="1">
          <mxGeometry height="54" width="1574" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="r_clients_box" parent="1" style="swimlane;html=1;rounded=1;startSize=28;horizontal=1;fillColor=#fffbeb;swimlaneFillColor=#ffffff;strokeColor=#f59e0b;fontColor=#92400e;fontStyle=1;strokeWidth=1.5;" value="&lt;b style=&quot;font-size:13px;color:#92400e;&quot;&gt;1. RIDER CLIENT &amp;amp; PARTNER APPLICATION LAYER&lt;/b&gt;" vertex="1">
          <mxGeometry height="120" width="1574" x="40" y="95" as="geometry" />
        </mxCell>
        <mxCell id="rc_1" parent="r_clients_box" style="rounded=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;strokeWidth=1.2;align=center;verticalAlign=middle;" value="Rider Mobile Application (React PWA / Android &amp; iOS)&#xA;Registration • Ghana Card KYC • Online Toggle • Dispatch Offers • GPS Turn-by-Turn • Customer OTP • Earnings Ledger" vertex="1">
          <mxGeometry height="60" width="680" x="50" y="40" as="geometry" />
        </mxCell>
        <mxCell id="rc_2" parent="r_clients_box" style="rounded=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;strokeWidth=1.2;align=center;verticalAlign=middle;" value="&lt;b&gt;Fleet operator portal&lt;/b&gt;&lt;br&gt;Future feature; not in the first release" vertex="1">
          <mxGeometry height="60" width="720" x="800" y="40" as="geometry" />
        </mxCell>
        <mxCell id="r_svc_box" parent="1" style="swimlane;html=1;rounded=1;startSize=28;horizontal=1;fillColor=#fffbeb;swimlaneFillColor=#ffffff;strokeColor=#f59e0b;fontColor=#92400e;fontStyle=1;strokeWidth=1.5;" value="&lt;b style=&quot;font-size:13px;color:#92400e;&quot;&gt;2. RIDER BACKEND — MODULAR APPLICATION SERVICES&lt;/b&gt;" vertex="1">
          <mxGeometry height="380" width="1574" x="40" y="235" as="geometry" />
        </mxCell>
        <mxCell id="rs_1" parent="r_svc_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b style=&quot;color:#92400e;&quot;&gt;Rider &amp;amp; Partner Management&lt;/b&gt;&lt;hr&gt;• MediFind-employed &amp;amp; Partner fleet riders&lt;br&gt;• Personal details &amp;amp; profile photographs&lt;br&gt;• Motorbike / Bicycle vehicle registration&lt;br&gt;• Partner roster linking &amp;amp; shift oversight" vertex="1">
          <mxGeometry height="95" width="350" x="30" y="42" as="geometry" />
        </mxCell>
        <mxCell id="rs_2" parent="r_svc_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b style=&quot;color:#92400e;&quot;&gt;Identity &amp;amp; KYC Verification&lt;/b&gt;&lt;hr&gt;• Ghana Card validation &amp;amp; NIA verification&lt;br&gt;• Driver's License &amp;amp; Roadworthy checks&lt;br&gt;• Document status: Pending, Verified, Rejected&lt;br&gt;• Admin suspension &amp;amp; reactivation handling" vertex="1">
          <mxGeometry height="95" width="360" x="410" y="42" as="geometry" />
        </mxCell>
        <mxCell id="rs_3" parent="r_svc_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b style=&quot;color:#92400e;&quot;&gt;Availability &amp;amp; Eligibility Engine&lt;/b&gt;&lt;hr&gt;• Online / Offline shift toggle&lt;br&gt;• Geolocation heartbeat polling (current rider location)&lt;br&gt;• Battery / connectivity status monitoring&lt;br&gt;• Active delivery busy lock prevention" vertex="1">
          <mxGeometry height="95" width="360" x="800" y="42" as="geometry" />
        </mxCell>
        <mxCell id="rs_4" parent="r_svc_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b style=&quot;color:#92400e;&quot;&gt;Delivery Assignment Engine&lt;/b&gt;&lt;hr&gt;• coordinate-based location search radius search near ready pharmacy&lt;br&gt;• 45-second timed dispatch broadcast queue&lt;br&gt;• Accept / Decline processing logic&lt;br&gt;• Automated cascading reassignment on timeout" vertex="1">
          <mxGeometry height="95" width="350" x="1190" y="42" as="geometry" />
        </mxCell>
        <mxCell id="rs_5" parent="r_svc_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b style=&quot;color:#92400e;&quot;&gt;Pickup &amp;amp; Handover Management&lt;/b&gt;&lt;hr&gt;• Pharmacy location &amp;amp; route navigation&lt;br&gt;• Pharmacy arrival notification trigger&lt;br&gt;• Sealed package inspection checklist&lt;br&gt;• Handover confirmation code validation" vertex="1">
          <mxGeometry height="95" width="350" x="30" y="150" as="geometry" />
        </mxCell>
        <mxCell id="rs_6" parent="r_svc_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b style=&quot;color:#92400e;&quot;&gt;Navigation &amp;amp; Location Tracking&lt;/b&gt;&lt;hr&gt;• Customer delivery route guidance&lt;br&gt;• Customer privacy: masked address until transit&lt;br&gt;• Real-time GPS coordinate streaming to customer&lt;br&gt;• Accurate dynamic ETA calculation" vertex="1">
          <mxGeometry height="95" width="360" x="410" y="150" as="geometry" />
        </mxCell>
        <mxCell id="rs_7" parent="r_svc_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b style=&quot;color:#92400e;&quot;&gt;Proof of Delivery &amp;amp; OTP Engine&lt;/b&gt;&lt;hr&gt;• Customer 6-digit secure OTP verification&lt;br&gt;• Max 3 attempts rate-limited validation&lt;br&gt;• GPS geotagged confirmation proof&lt;br&gt;• Fallback photo signature upload (Admin only)" vertex="1">
          <mxGeometry height="95" width="360" x="800" y="150" as="geometry" />
        </mxCell>
        <mxCell id="rs_8" parent="r_svc_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b style=&quot;color:#92400e;&quot;&gt;Failed Delivery &amp;amp; Return Workflow&lt;/b&gt;&lt;hr&gt;• Customer unreachable 10-min countdown&lt;br&gt;• 3 mandatory automated phone call logs&lt;br&gt;• Admin-approved return-to-pharmacy order&lt;br&gt;• Pharmacy return intake confirmation" vertex="1">
          <mxGeometry height="95" width="350" x="1190" y="150" as="geometry" />
        </mxCell>
        <mxCell id="rs_9" parent="r_svc_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b style=&quot;color:#92400e;&quot;&gt;Earnings &amp;amp; Payouts Ledger&lt;/b&gt;&lt;hr&gt;• Per-delivery base fee + distance bonus&lt;br&gt;• Delivery partner organization revenue split&lt;br&gt;• Weekly automated Mobile Money payout batches&lt;br&gt;• Transparent tip &amp;amp; bonus tracking" vertex="1">
          <mxGeometry height="95" width="350" x="30" y="258" as="geometry" />
        </mxCell>
        <mxCell id="rs_10" parent="r_svc_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b style=&quot;color:#92400e;&quot;&gt;Rider Notifications &amp;amp; Alerts&lt;/b&gt;&lt;hr&gt;• High-priority audio dispatch alerts&lt;br&gt;• Pharmacy preparation progress updates&lt;br&gt;• Return authorization instructions&lt;br&gt;• Payout &amp;amp; weekly earnings summaries" vertex="1">
          <mxGeometry height="95" width="360" x="410" y="258" as="geometry" />
        </mxCell>
        <mxCell id="rs_11" parent="r_svc_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b style=&quot;color:#92400e;&quot;&gt;Incident &amp;amp; Support Desk&lt;/b&gt;&lt;hr&gt;• Roadside breakdown / emergency report&lt;br&gt;• Package damage exception reporting&lt;br&gt;• Customer dispute / hostile location flag&lt;br&gt;• Instant dispatcher live chat link" vertex="1">
          <mxGeometry height="95" width="360" x="800" y="258" as="geometry" />
        </mxCell>
        <mxCell id="rs_12" parent="r_svc_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b style=&quot;color:#92400e;&quot;&gt;Performance &amp;amp; Audit Analytics&lt;/b&gt;&lt;hr&gt;• On-time delivery rate &amp;amp; SLA tracking&lt;br&gt;• Acceptance vs Decline ratio monitoring&lt;br&gt;• Customer delivery satisfaction rating&lt;br&gt;• Immutable transit &amp;amp; GPS audit logging" vertex="1">
          <mxGeometry height="95" width="350" x="1190" y="258" as="geometry" />
        </mxCell>
        <mxCell id="r_data_box" parent="1" style="swimlane;html=1;rounded=1;startSize=28;horizontal=1;fillColor=#fffbeb;swimlaneFillColor=#ffffff;strokeColor=#f59e0b;fontColor=#92400e;fontStyle=1;strokeWidth=1.5;" value="&lt;b style=&quot;font-size:13px;color:#92400e;&quot;&gt;3. RIDER DATA DOMAIN (UNIFIED SCHEMA ENTITIES)&lt;/b&gt;" vertex="1">
          <mxGeometry height="180" width="1574" x="40" y="630" as="geometry" />
        </mxCell>
        <mxCell id="re_1" parent="r_data_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b style=&quot;color:#92400e;&quot;&gt;Rider Profile &amp;amp; Partners&lt;/b&gt;&lt;hr&gt;&lt;b&gt;RIDERS:&lt;/b&gt; id, user_id, rider_type (Employed/Partner), kyc_status, account_status&lt;br&gt;&lt;b&gt;RIDER_DOCS:&lt;/b&gt; id, rider_id, doc_type (GhanaCard/License), file_ref, status&lt;br&gt;&lt;b&gt;RIDER_VEHICLES:&lt;/b&gt; id, rider_id, vehicle_type, reg_no, insurance_expiry&lt;br&gt;&lt;b&gt;DELIVERY_PARTNERS:&lt;/b&gt; id, company_name, contact, commission_pct, status" vertex="1">
          <mxGeometry height="125" width="480" x="30" y="38" as="geometry" />
        </mxCell>
        <mxCell id="re_2" parent="r_data_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b style=&quot;color:#92400e;&quot;&gt;Deliveries &amp;amp; Tracking Operations&lt;/b&gt;&lt;hr&gt;&lt;b&gt;DELIVERIES:&lt;/b&gt; id, order_id, pharmacy_id, customer_id, delivery_status, fee&lt;br&gt;&lt;b&gt;DELIVERY_ASSIGNMENTS:&lt;/b&gt; id, delivery_id, rider_id, status (Offered/Accepted/Declined)&lt;br&gt;&lt;b&gt;RIDER_LOCATIONS:&lt;/b&gt; id, rider_id, latitude, longitude, heading, recorded_at&lt;br&gt;&lt;b&gt;DELIVERY_PROOFS:&lt;/b&gt; id, delivery_id, proof_type (OTP/Photo), otp_hash, confirmed_at" vertex="1">
          <mxGeometry height="125" width="490" x="540" y="38" as="geometry" />
        </mxCell>
        <mxCell id="re_3" parent="r_data_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b style=&quot;color:#92400e;&quot;&gt;Rider Earnings &amp;amp; Support&lt;/b&gt;&lt;hr&gt;&lt;b&gt;RIDER_EARNINGS:&lt;/b&gt; id, rider_id, delivery_id, base_fee, distance_fee, tip, net_pay&lt;br&gt;&lt;b&gt;RIDER_PAYOUTS:&lt;/b&gt; id, rider_id, amount, payout_method (MoMo), status, trans_ref&lt;br&gt;&lt;b&gt;RIDER_AVAILABILITY:&lt;/b&gt; id, rider_id, status (Online/Offline/Busy), started_at, ended_at&lt;br&gt;&lt;b&gt;SUPPORT_TICKETS:&lt;/b&gt; id, rider_id, issue_type, priority, status, created_at" vertex="1">
          <mxGeometry height="125" width="480" x="1060" y="38" as="geometry" />
        </mxCell>
        <mxCell id="r_note" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;fontSize=11;align=left;verticalAlign=middle;strokeWidth=1.2;spacing=10;" value="&lt;b&gt;RIDER DATA PRIVACY &amp;amp; SECURITY COMPLIANCE:&lt;/b&gt; In accordance with medical ethics and Ghana Data Protection regulations, riders NEVER receive patient medical diagnosis, drug names, or therapeutic details. The customer delivery address is obfuscated until package pickup is confirmed at the pharmacy. Live GPS streaming terminates immediately upon OTP validation." vertex="1">
          <mxGeometry height="55" width="1574" x="40" y="830" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p06-admin" name="PAGE 6 — Admin Module Architecture">
    <mxGraphModel dx="1640" dy="1714" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_2" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#0f172a;strokeColor=#1e293b;fontColor=#ffffff;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:18px;&quot;&gt;MEDIFIND | ADMIN MODULE — CENTRAL OPERATIONS &amp;amp; GOVERNANCE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#94a3b8;&quot;&gt;Central Operations Desk: User Management, Verification Desk, Platform Control, Financial Settlements &amp;amp; Regulatory Audits&lt;/span&gt;" vertex="1">
          <mxGeometry height="54" width="1574" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="ad_1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;fontColor=#5b21b6;fontSize=11;align=center;verticalAlign=top;strokeWidth=1.4;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;A. User &amp;amp; Entity Management&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;text-align:left;&quot;&gt;• Comprehensive view of all registered entities&lt;br&gt;• Customers, Pharmacies, Riders, Partners, Admins&lt;br&gt;• Role-Based Access Control (RBAC) configuration&lt;br&gt;• Granular permissions &amp;amp; administrative roles&lt;br&gt;• Account activation, suspension &amp;amp; reinstatement&lt;br&gt;• Super Admin vs Support vs Compliance roles&lt;br&gt;• Multi-Factor Authentication (MFA) enforcement&lt;/div&gt;" vertex="1">
          <mxGeometry height="215" width="360" x="40" y="95" as="geometry" />
        </mxCell>
        <mxCell id="ad_2" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;fontColor=#5b21b6;fontSize=11;align=center;verticalAlign=top;strokeWidth=1.4;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;B. Verification &amp;amp; Compliance Desk&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;text-align:left;&quot;&gt;• Pharmacy business &amp;amp; premises license inspection&lt;br&gt;• Supervising Pharmacist PIN &amp;amp; Council vetting&lt;br&gt;• Rider Ghana Card identity &amp;amp; license verification&lt;br&gt;• Delivery Partner corporate registry vetting&lt;br&gt;• Secure document viewer for uploaded PDF/scans&lt;br&gt;• Approval or Rejection with mandatory audit reason&lt;br&gt;• Automated credential expiry notifications&lt;/div&gt;" vertex="1">
          <mxGeometry height="215" width="360" x="440" y="95" as="geometry" />
        </mxCell>
        <mxCell id="ad_3" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;fontColor=#5b21b6;fontSize=11;align=center;verticalAlign=top;strokeWidth=1.4;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;C. Live Operations &amp;amp; Dispatch Control&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;text-align:left;&quot;&gt;• Real-time map of active orders &amp;amp; rider routes&lt;br&gt;• Bottleneck &amp;amp; SLA breach alert triggers&lt;br&gt;• Stuck order intervention &amp;amp; manual reassignment&lt;br&gt;• Failed delivery review &amp;amp; return authorization&lt;br&gt;• Customer / Pharmacy / Rider dispute mediation&lt;br&gt;• Emergency delivery escalation handling&lt;br&gt;• System-wide order cancellation oversight&lt;/div&gt;" vertex="1">
          <mxGeometry height="215" width="360" x="840" y="95" as="geometry" />
        </mxCell>
        <mxCell id="ad_4" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;fontColor=#5b21b6;fontSize=11;align=center;verticalAlign=top;strokeWidth=1.4;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;D. Financial Administration &amp;amp; Ledger&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;text-align:left;&quot;&gt;• Platform transaction &amp;amp; escrow payment tracking&lt;br&gt;• Pharmacy commission percentage configuration&lt;br&gt;• Rider base fee, distance rate &amp;amp; commission rules&lt;br&gt;• Automated pharmacy weekly settlement approvals&lt;br&gt;• Rider Mobile Money payout batch authorizations&lt;br&gt;• Refund processing &amp;amp; dispute chargebacks&lt;br&gt;• Bank / Payment gateway financial reconciliation&lt;/div&gt;" vertex="1">
          <mxGeometry height="215" width="370" x="1240" y="95" as="geometry" />
        </mxCell>
        <mxCell id="ad_5" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;fontColor=#5b21b6;fontSize=11;align=center;verticalAlign=top;strokeWidth=1.4;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;E. Platform Master Configuration&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;text-align:left;&quot;&gt;• Central medicine categorization &amp;amp; therapeutic classes&lt;br&gt;• Controlled substances &amp;amp; prescription mandate rules&lt;br&gt;• Geofenced active delivery zones &amp;amp; coverage limits&lt;br&gt;• Base delivery pricing tiers &amp;amp; surge multipliers&lt;br&gt;• System maintenance mode &amp;amp; operating banners&lt;br&gt;• SMS / Push / Email notification template manager&lt;br&gt;• Privacy policy &amp;amp; platform terms versioning&lt;/div&gt;" vertex="1">
          <mxGeometry height="215" width="480" x="40" y="335" as="geometry" />
        </mxCell>
        <mxCell id="ad_6" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;fontColor=#5b21b6;fontSize=11;align=center;verticalAlign=top;strokeWidth=1.4;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;F. Business Intelligence &amp;amp; Reporting&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;text-align:left;&quot;&gt;• Executive KPI dashboard: GMV, Orders, Net Revenue&lt;br&gt;• Customer acquisition, retention &amp;amp; order frequency&lt;br&gt;• Pharmacy fulfillment speed &amp;amp; stockout rate analytics&lt;br&gt;• Rider acceptance, delivery SLA &amp;amp; satisfaction scores&lt;br&gt;• High-demand medication trend analysis by district&lt;br&gt;• Failed delivery, return rate &amp;amp; dispute root causes&lt;br&gt;• Exportable statutory CSV / Excel reporting suites&lt;/div&gt;" vertex="1">
          <mxGeometry height="215" width="480" x="560" y="335" as="geometry" />
        </mxCell>
        <mxCell id="ad_7" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;fontColor=#5b21b6;fontSize=11;align=center;verticalAlign=top;strokeWidth=1.4;spacing=6;shadow=1;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;G. Security, Auditing &amp;amp; Compliance&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;text-align:left;&quot;&gt;• Immutable audit log of all administrative actions&lt;br&gt;• Patient prescription &amp;amp; health data access audit logs&lt;br&gt;• Failed authentication &amp;amp; suspicious IP activity alerts&lt;br&gt;• Permission escalation &amp;amp; role modification history&lt;br&gt;• Account freeze &amp;amp; data retention policy controls&lt;br&gt;• Regulatory compliance exports (Pharmacy Council / DPC)&lt;br&gt;• Least-privilege access enforcement monitoring&lt;/div&gt;" vertex="1">
          <mxGeometry height="215" width="530" x="1080" y="335" as="geometry" />
        </mxCell>
        <mxCell id="ad_rbac_box" parent="1" style="swimlane;html=1;rounded=1;startSize=28;horizontal=1;fillColor=#f5f3ff;swimlaneFillColor=#ffffff;strokeColor=#8b5cf6;fontColor=#5b21b6;fontStyle=1;strokeWidth=1.5;" value="&lt;b style=&quot;font-size:13px;color:#5b21b6;&quot;&gt;ADMINISTRATIVE ROLE MATRIX &amp;amp; ACCESS HIERARCHY (LEAST-PRIVILEGE PRINCIPLE)&lt;/b&gt;" vertex="1">
          <mxGeometry height="200" width="1574" x="40" y="575" as="geometry" />
        </mxCell>
        <mxCell id="r_super" parent="ad_rbac_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c4b5fd;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b style=&quot;color:#5b21b6;font-size:11px;&quot;&gt;Super Administrator&lt;/b&gt;&lt;hr&gt;• Full platform read/write permissions&lt;br&gt;• Admin user creation &amp;amp; role assignment&lt;br&gt;• Platform fee &amp;amp; commission configuration&lt;br&gt;• Financial settlement batch approvals&lt;br&gt;• Database backup &amp;amp; security key management&lt;br&gt;• Dual-approval required for sensitive actions" vertex="1">
          <mxGeometry height="140" width="350" x="30" y="38" as="geometry" />
        </mxCell>
        <mxCell id="r_ops" parent="ad_rbac_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c4b5fd;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b style=&quot;color:#5b21b6;font-size:11px;&quot;&gt;Operations Dispatch Manager&lt;/b&gt;&lt;hr&gt;• Real-time dispatch map monitoring&lt;br&gt;• Rider assignment override &amp;amp; stuck order routing&lt;br&gt;• Return-to-pharmacy authorization&lt;br&gt;• Live delivery issue resolution&lt;br&gt;• No access to sensitive financial configuration" vertex="1">
          <mxGeometry height="140" width="360" x="410" y="38" as="geometry" />
        </mxCell>
        <mxCell id="r_comp" parent="ad_rbac_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c4b5fd;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b style=&quot;color:#5b21b6;font-size:11px;&quot;&gt;Compliance &amp;amp; Verification Officer&lt;/b&gt;&lt;hr&gt;• Pharmacy license &amp;amp; Council PIN verification&lt;br&gt;• Rider Ghana Card KYC document vetting&lt;br&gt;• Document approval/rejection decision entry&lt;br&gt;• Controlled substance compliance audit&lt;br&gt;• Access logs for patient data inspections" vertex="1">
          <mxGeometry height="140" width="360" x="800" y="38" as="geometry" />
        </mxCell>
        <mxCell id="r_fin" parent="ad_rbac_box" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c4b5fd;fontColor=#0f172a;fontSize=10;align=left;verticalAlign=top;strokeWidth=1.2;spacing=6;" value="&lt;b style=&quot;color:#5b21b6;font-size:11px;&quot;&gt;Finance &amp;amp; Settlement Officer&lt;/b&gt;&lt;hr&gt;• Escrow transaction monitoring&lt;br&gt;• Pharmacy settlement calculation review&lt;br&gt;• Rider payout batch preparation&lt;br&gt;• Refund &amp;amp; dispute fee reconciliation&lt;br&gt;• Statutory financial report generation" vertex="1">
          <mxGeometry height="140" width="350" x="1190" y="38" as="geometry" />
        </mxCell>
        <mxCell id="ad_note" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;fontSize=11;align=left;verticalAlign=middle;strokeWidth=1.2;spacing=10;" value="&lt;b&gt;ADMINISTRATIVE GOVERNANCE PRINCIPLE:&lt;/b&gt; The Admin Module serves as an oversight and governance layer. It never directly bypasses the business rules of the Customer, Pharmacist, or Rider modules. All administrative overrides (such as manual rider reassignment or refund approval) generate immutable audit records referencing the authorized administrator ID and operational justification." vertex="1">
          <mxGeometry height="55" width="1574" x="40" y="800" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
