          <mxGeometry height="280" width="530" x="560" y="410" as="geometry" />
        </mxCell>
        <mxCell id="actor_cust" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e3a8a;fontSize=12;align=center;verticalAlign=top;strokeWidth=1.8;spacing=8;shadow=1;" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Customer (Patient / Buyer)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748b;&quot;&gt;[Mobile App / Web PWA]&lt;/span&gt;&lt;hr&gt;&lt;div style=&quot;font-size:11px;text-align:left;&quot;&gt;• Discovers medicines &amp;amp; locates licensed pharmacies&lt;br&gt;• Uploads medical prescriptions for validation&lt;br&gt;• Submits orders &amp;amp; pays securely via Mobile Money/Card&lt;br&gt;• Monitors delivery live &amp;amp; confirms handover via OTP&lt;br&gt;• Sets personal medication pill &amp;amp; refill reminders&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="300" x="130" y="210" as="geometry" />
        </mxCell>
        <mxCell id="actor_pharm" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontColor=#065f46;fontSize=12;align=center;verticalAlign=top;strokeWidth=1.8;spacing=8;shadow=1;" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Pharmacist &amp;amp; Pharmacy Staff&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748b;&quot;&gt;[Pharmacy Web Management Portal]&lt;/span&gt;&lt;hr&gt;&lt;div style=&quot;font-size:11px;text-align:left;&quot;&gt;• Manages medicine catalogue &amp;amp; batch inventory&lt;br&gt;• Evaluates &amp;amp; validates submitted prescriptions&lt;br&gt;• Confirms availability &amp;amp; proposes substitutions&lt;br&gt;• Prepares, labels, &amp;amp; tamper-seals packages&lt;br&gt;• Verifies rider identity &amp;amp; confirms package handover&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="300" x="-50" y="470" as="geometry" />
        </mxCell>
        <mxCell id="actor_rider" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;fontColor=#92400e;fontSize=12;align=center;verticalAlign=top;strokeWidth=1.8;spacing=8;shadow=1;" value="&lt;b&gt;Delivery Rider&lt;/b&gt;&lt;br&gt;&lt;span&gt;[React PWA]&lt;/span&gt;&lt;hr&gt;Accepts delivery offers, collects sealed orders, updates delivery status and confirms handover with a one-time code." vertex="1">
          <mxGeometry height="160" width="300" x="70" y="710" as="geometry" />
        </mxCell>
        <mxCell id="actor_admin" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;fontColor=#5b21b6;fontSize=12;align=center;verticalAlign=top;strokeWidth=1.8;spacing=8;shadow=1;" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Platform Administrator &amp;amp; Ops (incl. Super Admin)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748b;&quot;&gt;[Central Operations &amp;amp; Control Console]&lt;/span&gt;&lt;hr&gt;&lt;div style=&quot;font-size:11px;text-align:left;&quot;&gt;• Vets &amp;amp; approves pharmacy &amp;amp; rider credentials&lt;br&gt;• Monitors real-time orders, dispatches &amp;amp; exceptions&lt;br&gt;• Configures platform commissions, zones &amp;amp; fees&lt;br&gt;• Manages dispute escalations, returns &amp;amp; refunds&lt;br&gt;• Audits immutable system &amp;amp; security access logs&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="300" x="140" y="930" as="geometry" />
        </mxCell>
